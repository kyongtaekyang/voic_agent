# voice_agent 저장소 제외 목록
# 원칙: 음성 파일, 대화·인식 원문, 로그, 가상환경, 모델 가중치, 인증 정보는 올리지 않는다.

# Python 가상환경과 캐시
.venv/
.venv-*/
__pycache__/
*.pyc
.pytest_cache/
**/.cache/

# 로그와 실행 상태
**/logs/
ada-ops/run/
*.log
*.pid
*.bak.*

# 음성 파일 (참조 녹음 링크, 합성 결과 모두 제외)
*.wav
*.mp3
*.flac
*.ogg
*.webm
**/bench/out/
**/bench/data/ko_ref/

# 직원 참조 녹음의 인식 원문이 들어 있는 측정 결과 (요약 수치는 stage1_report.md 에 있음)
korean_agent/docs/reports/asr_cpu_rtf_*.json
korean_agent/docs/reports/*sweep*.log

# 세션 녹음 대기열 (Slow Path)
**/queue/

# 모델 가중치
*.safetensors
*.gguf
*.onnx
*.pt
*.bin

# 인증 정보
.env
*.env
!*.env.example
*.pem
*.key
