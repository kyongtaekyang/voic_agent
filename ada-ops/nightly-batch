#!/usr/bin/env bash
# nightly-batch: 후처리 모드 야간 배치 (프롬프트 2.2절, 9.2절). 순서를 고정한다.
#
#   1) gpu-mode batch        실시간 서비스를 내리고 Transcribe 30B(:8002)를 올린다   (queued 세션이 있을 때만)
#   2) slow_path transcribe  queue/korean/ 의 queued 세션을 축어 전사, 실시간 STT CER 등 지표 계산
#   3) gpu-mode summary      Transcribe 를 내리고 Gemma 4(:8001)만 올린다 (후처리 모드에는 Gemma 가 없으므로)
#   4) slow_path summarize   transcribed 세션의 요약·학습 피드백 생성
#   5) gpu-mode stop         (--then realtime 이면 실시간 모드로 되돌린다)
#
#   nightly-batch [--dry-run] [--then realtime]
# 다른 사용자의 GPU 프로세스는 건드리지 않는다. GPU 여유가 부족하면 gpu-mode 가 거부한다.
# **중간에 실패해도 5) 는 반드시 실행한다** (EXIT trap). gpu-mode 는 메모리를 확인하기 전에 다른 모드의 서비스를 먼저 내리므로,
# 이 처리가 없으면 실패한 밤 다음 날 아침에 Agent 가 모두 내려가 있게 된다.
# 처리할 세션이 없으면 GPU 모델을 올리지 않고 끝낸다.
set -euo pipefail
OPS="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
KVA="$OPS/../korean_agent"
DRY=""; THEN=""
while [[ $# -gt 0 ]]; do
  case "$1" in --dry-run) DRY="--dry-run" ;; --then) THEN="$2"; shift ;; *) echo "모르는 옵션: $1"; exit 2 ;; esac
  shift
done
say() { echo "[nightly-batch $(date '+%F %T')] $*"; }
sp() { (cd "$KVA" && CUDA_VISIBLE_DEVICES= .venv/bin/python -m slow_path.run "$@"); }

STARTED=0
finish() {
  local rc=$?
  trap - EXIT
  if [[ $STARTED == 1 ]]; then
    if [[ -n "$THEN" ]]; then
      say "5) $THEN 모드로 전환"
      "$OPS/gpu-mode" "$THEN" $DRY || { say "$THEN 전환 실패: 서비스를 모두 내립니다"; "$OPS/gpu-mode" stop $DRY || true; rc=1; }
    else
      say "5) 서비스 중지"; "$OPS/gpu-mode" stop $DRY || rc=1
    fi
  fi
  say "끝 (종료 코드 $rc. 세션별 실패 내용은 각 세션 meta.json 의 errors)"
  exit $rc
}
trap finish EXIT

status="$(sp status)"
say "대기열: $status"
read -r queued transcribed < <(echo "$status" | python3 -c 'import json,sys; s=json.load(sys.stdin)["sessions"]; print(s.get("queued",0), s.get("transcribed",0))')
if [[ "$queued" == "0" && "$transcribed" == "0" ]]; then say "처리할 세션 없음."; exit 0; fi

rc=0
STARTED=1
if [[ "$queued" != "0" ]]; then
  say "1) 후처리 모드로 전환"; "$OPS/gpu-mode" batch $DRY
  if [[ -z "$DRY" ]]; then say "2) 축어 전사"; sp transcribe || rc=$?; fi
else
  say "1)~2) queued 세션이 없어서 전사를 건너뜀"
fi
say "3) 요약 모드로 전환 (Transcribe 내림, Gemma 올림)"; "$OPS/gpu-mode" summary $DRY
if [[ -z "$DRY" ]]; then say "4) 요약"; sp summarize || rc=$?; fi
exit $rc
