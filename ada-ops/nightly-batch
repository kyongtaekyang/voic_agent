#!/usr/bin/env bash
# nightly-batch: 후처리 모드 야간 배치 (한국어 프롬프트 2.2절·9.2절, 영어 프롬프트 5절 6단계·8.2절). 순서를 고정한다.
#
#   1) gpu-mode batch        실시간 서비스를 내리고 Transcribe 30B(:8002)를 올린다   (queued 세션이 한쪽이라도 있을 때만)
#   2) slow_path transcribe  queue/korean/, queue/english/ 의 queued 세션을 축어 전사하고 지표 계산
#                            (영어는 이어서 slow_path report 로 queue/english/_kpi.json 갱신)
#   3) gpu-mode summary      Transcribe 를 내리고 Gemma 4(:8001)만 올린다 (한국어 transcribed 세션이 있을 때만. 영어는 요약 없음)
#   4) slow_path summarize   한국어 transcribed 세션의 요약·학습 피드백 생성
#   5) gpu-mode stop         (--then realtime 이면 실시간 모드로 되돌린다)
#
#   nightly-batch [--dry-run] [--then realtime]
# 다른 사용자의 GPU 프로세스는 건드리지 않는다. GPU 여유가 부족하면 gpu-mode 가 거부한다.
# **중간에 실패해도 5) 는 반드시 실행한다** (EXIT trap). gpu-mode 는 메모리를 확인하기 전에 다른 모드의 서비스를 먼저 내리므로,
# 이 처리가 없으면 실패한 밤 다음 날 아침에 Agent 가 모두 내려가 있게 된다.
# 처리할 세션이 없으면 GPU 모델을 올리지 않고 끝낸다.
set -euo pipefail
OPS="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
KVA="$OPS/../korean_agent"
EVA="$OPS/../english-agent"
DRY=""; THEN=""
while [[ $# -gt 0 ]]; do
  case "$1" in --dry-run) DRY="--dry-run" ;; --then) THEN="$2"; shift ;; *) echo "모르는 옵션: $1"; exit 2 ;; esac
  shift
done
say() { echo "[nightly-batch $(date '+%F %T')] $*"; }
# NB_KO_QUEUE / NB_EN_QUEUE: 대기열 폴더를 바꿀 때만 (시험용). 지정하지 않으면 각 Agent 의 config/services.yaml 값
sp() { (cd "$KVA" && CUDA_VISIBLE_DEVICES= .venv/bin/python -m slow_path.run "$@" ${NB_KO_QUEUE:+--queue "$NB_KO_QUEUE"}); }
sp_en() { (cd "$EVA" && CUDA_VISIBLE_DEVICES= .venv-core/bin/python -m slow_path.run "$@" ${NB_EN_QUEUE:+--queue "$NB_EN_QUEUE"}); }
count() { python3 -c 'import json,sys; s=json.load(sys.stdin)["sessions"]; print(s.get(sys.argv[1],0))' "$1"; }

STARTED=0
finish() {
  local rc=$?
  trap - EXIT
  if [[ $STARTED == 1 ]]; then
    if [[ -n "$THEN" ]]; then
      say "5) $THEN 모드로 전환"
      "$OPS/gpu-mode" "$THEN" $DRY || { say "$THEN 전환 실패: 서비스를 모두 내립니다"; "$OPS/gpu-mode" stop $DRY || true; rc=1; }
    else
      say "5) 서비스 중지"; "$OPS/gpu-mode" stop $DRY || rc=1
    fi
  fi
  say "끝 (종료 코드 $rc. 세션별 실패 내용은 각 세션 meta.json 의 errors)"
  exit $rc
}
trap finish EXIT

ko="$(sp status)"; en="$(sp_en status)"
say "대기열 (한국어): $ko"
say "대기열 (영어):   $en"
ko_q=$(echo "$ko" | count queued); ko_t=$(echo "$ko" | count transcribed); en_q=$(echo "$en" | count queued)
if [[ "$ko_q" == "0" && "$ko_t" == "0" && "$en_q" == "0" ]]; then say "처리할 세션 없음."; exit 0; fi

rc=0
STARTED=1
if [[ "$ko_q" != "0" || "$en_q" != "0" ]]; then
  say "1) 후처리 모드로 전환"; "$OPS/gpu-mode" batch $DRY
  if [[ -z "$DRY" ]]; then
    if [[ "$ko_q" != "0" ]]; then say "2) 축어 전사 (한국어)"; sp transcribe || rc=$?; fi
    if [[ "$en_q" != "0" ]]; then
      say "2) 축어 전사 (영어)"; sp_en transcribe || rc=$?
      sp_en report || rc=$?
    fi
  fi
else
  say "1)~2) queued 세션이 없어서 전사를 건너뜀"
fi

# 요약할 한국어 세션이 있을 때만 Gemma 를 올린다 (dry-run 은 전사가 모두 성공했다고 가정)
if [[ -z "$DRY" ]]; then ko_t=$(sp status | count transcribed); else ko_t=$((ko_q + ko_t)); fi
if [[ "$ko_t" != "0" ]]; then
  say "3) 요약 모드로 전환 (Transcribe 내림, Gemma 올림)"; "$OPS/gpu-mode" summary $DRY
  if [[ -z "$DRY" ]]; then say "4) 요약 (한국어)"; sp summarize || rc=$?; fi
else
  say "3)~4) 요약할 한국어 세션이 없어서 건너뜀"
fi
exit $rc
