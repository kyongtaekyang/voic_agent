#!/usr/bin/env bash
# gpu-mode: Ada 서버 공유 GPU 운영 모드 전환 (영어·한국어 Agent 공용, 하나만 둔다)
#
#   gpu-mode status                 현재 모드, 우리 서비스, GPU 사용 프로세스(소유자 포함)
#   gpu-mode realtime|batch|train   다른 모드 서비스를 멈추고 이 모드 서비스를 순서대로 시작
#   gpu-mode stop                   우리 서비스 전부 중지
#   gpu-mode need <mode>            이 모드로 바꿀 때 새로 필요한 GPU MiB (ada-ops/gpu-wait 가 쓴다)
#   gpu-mode mem                    total used free ours (MiB, ours = 이 스크립트가 시작한 프로세스)
#   옵션: --dry-run (실제로 시작·중지하지 않음), --force (GPU 여유 부족 경고를 무시)
#
# 규칙
# - 이 스크립트가 시작한 프로세스(run/*.pid)만 멈춘다. 다른 사용자·다른 프로그램의 GPU 프로세스는 절대 건드리지 않는다.
# - 모드별 서비스와 기동 순서, 필요 메모리는 modes.conf 에 고정한다 (gpu_layout.md 와 같이 고칠 것).
# - 서비스 실행 방법은 services/<이름>.sh 에 둔다. 파일이 없으면 "미구현"으로 건너뛴다.
set -euo pipefail

OPS="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
RUN="$OPS/run"; LOGS="$OPS/logs"; CONF="$OPS/modes.conf"
mkdir -p "$RUN" "$LOGS"

DRY=0; FORCE=0; ARGS=()
for a in "$@"; do
  case "$a" in --dry-run) DRY=1 ;; --force) FORCE=1 ;; *) ARGS+=("$a") ;; esac
done
CMD="${ARGS[0]:-status}"

say() { echo "[gpu-mode] $*"; }

# modes.conf 형식:  <mode> <순서> <서비스이름> <필요GPU_MiB>
services_of() { awk -v m="$1" '$1==m {print $2, $3, $4}' "$CONF" | sort -n | awk '{print $2, $3}'; }
all_services() { awk '!/^#/ && NF>=4 {print $3}' "$CONF" | sort -u; }

is_running() { local f="$RUN/$1.pid"; [[ -f "$f" ]] && kill -0 "$(cat "$f")" 2>/dev/null; }

stop_service() {
  local n="$1" f="$RUN/$1.pid"
  is_running "$n" || { rm -f "$f"; return 0; }
  local pid; pid="$(cat "$f")"
  # 우리 사용자 소유인지 다시 확인
  [[ "$(ps -o user= -p "$pid" | tr -d ' ')" == "$(id -un)" ]] || { say "경고: $n pid $pid 소유자가 다릅니다. 건드리지 않습니다."; return 1; }
  say "중지: $n (pid $pid)"
  [[ $DRY == 1 ]] && return 0
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  for _ in $(seq 1 30); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
  kill -0 "$pid" 2>/dev/null && { say "강제 종료: $n"; kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true; }
  rm -f "$f"
}

gpu_free() { nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits | head -1 | tr -d ' '; }

our_pids() { local ours=" "; for f in "$RUN"/*.pid; do [[ -f "$f" ]] && ours+="$(cat "$f") "; done; echo "$ours"; }

# GPU 프로세스가 우리 서비스(또는 그 자식, 같은 프로세스 그룹)인가
is_ours() { local pg; pg="$(ps -o pgid= -p "$2" 2>/dev/null | tr -d ' ')" || pg=""; [[ "$1" == *" $2 "* || ( -n "$pg" && "$1" == *" $pg "* ) ]]; }

mem() {
  local ours sum=0; ours="$(our_pids)"
  while IFS=', ' read -r pid m; do
    [[ -z "$pid" ]] && continue
    is_ours "$ours" "$pid" && sum=$((sum + m))
  done < <(nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader,nounits 2>/dev/null)
  nvidia-smi --query-gpu=memory.total,memory.used,memory.free --format=csv,noheader,nounits | head -1 | tr -d ' ' | tr ',' ' ' | tr -d '\n'
  echo " $sum"
}

need_of() {
  local need=0
  while read -r n mib; do
    [[ -x "$OPS/services/$n.sh" ]] || continue   # 미구현 서비스는 계산에서 뺀다
    is_running "$n" || need=$((need + mib))
  done < <(services_of "$1")
  echo "$need"
}

foreign_gpu() {
  # 우리 run/*.pid 에 없는 GPU 프로세스: pid user MiB command
  local ours=" "; for f in "$RUN"/*.pid; do [[ -f "$f" ]] && ours+="$(cat "$f") "; done
  nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader,nounits 2>/dev/null |
  while IFS=', ' read -r pid mem; do
    [[ -z "$pid" ]] && continue
    # 우리 서비스의 자식 프로세스도 우리 것으로 본다
    local pg; pg="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')" || pg=""   # 그 사이 종료된 프로세스: pipefail 로 status 가 실패하지 않게
    [[ "$ours" == *" $pid "* || "$ours" == *" $pg "* ]] && continue
    printf "  pid %-8s %-8s %6s MiB  %s\n" "$pid" "$(ps -o user= -p "$pid" 2>/dev/null)" "$mem" "$(ps -o args= -p "$pid" 2>/dev/null | cut -c1-90)"
  done
}

status() {
  local mode="(없음)"; [[ -f "$RUN/mode" ]] && mode="$(cat "$RUN/mode")"
  say "현재 모드: $mode"
  nvidia-smi --query-gpu=name,memory.total,memory.used,memory.free --format=csv,noheader | sed 's/^/  GPU: /'
  say "우리 서비스:"
  for n in $(all_services); do
    if is_running "$n"; then echo "  $n: 실행 중 (pid $(cat "$RUN/$n.pid"))"
    elif [[ -x "$OPS/services/$n.sh" ]]; then echo "  $n: 중지"
    else echo "  $n: 미구현 (services/$n.sh 없음)"; fi
  done
  say "다른 GPU 프로세스 (이 스크립트가 관리하지 않음):"
  foreign_gpu
}

switch_to() {
  local mode="$1"
  grep -qE "^$mode[[:space:]]" "$CONF" || { say "모르는 모드: $mode"; exit 2; }
  # 1) 다른 모드 서비스 중지
  local keep; keep=" $(services_of "$mode" | awk '{print $1}' | tr '\n' ' ') "
  for n in $(all_services); do [[ "$keep" == *" $n "* ]] || stop_service "$n"; done
  for n in $(all_services); do
    [[ "$keep" == *" $n "* ]] && continue
    is_running "$n" && [[ $DRY == 0 ]] && { say "실패: $n 이 아직 실행 중입니다. 모드 전환을 중단합니다."; exit 1; }
  done
  # 2) 메모리 확인
  local need; need="$(need_of "$mode")"
  local free; free="$(gpu_free)"
  say "모드 $mode: 새로 필요한 GPU 약 ${need} MiB, 현재 여유 ${free} MiB"
  if (( need > free )); then
    say "GPU 여유가 부족합니다. 아래 프로세스가 메모리를 쓰고 있습니다:"; foreign_gpu
    [[ $FORCE == 1 ]] || { say "중단합니다 (--force 로 무시 가능, 다른 사용자 프로세스는 멈추지 않습니다)."; exit 1; }
  fi
  # 3) 순서대로 시작
  while read -r n mib; do
    is_running "$n" && { say "이미 실행 중: $n"; continue; }
    local s="$OPS/services/$n.sh"
    [[ -x "$s" ]] || { say "건너뜀: $n (services/$n.sh 미구현)"; continue; }
    say "시작: $n"
    [[ $DRY == 1 ]] && continue
    setsid "$s" >>"$LOGS/$n.log" 2>&1 < /dev/null &
    echo $! > "$RUN/$n.pid"
    # 서비스별 준비 확인: services/<이름>.ready 가 있으면 성공할 때까지 최대 600초 대기 (vLLM 기동 순서 보장)
    if [[ -x "$OPS/services/$n.ready" ]]; then
      for i in $(seq 1 600); do "$OPS/services/$n.ready" >/dev/null 2>&1 && break
        is_running "$n" || { say "실패: $n 이 종료됐습니다. 로그: $LOGS/$n.log"; exit 1; }; sleep 1; done
    fi
  done < <(services_of "$mode")
  [[ $DRY == 1 ]] || echo "$mode" > "$RUN/mode"
  status
}

case "$CMD" in
  status) status ;;
  stop) for n in $(all_services); do stop_service "$n"; done; [[ $DRY == 1 ]] || rm -f "$RUN/mode"; status ;;
  need) grep -qE "^${ARGS[1]:-}[[:space:]]" "$CONF" || { say "모르는 모드: ${ARGS[1]:-}"; exit 2; }; need_of "${ARGS[1]}" ;;
  mem) mem ;;
  -h|--help|help) sed -n '2,11p' "$0" ;;
  *) switch_to "$CMD" ;;   # realtime | batch | train (modes.conf 에 정의된 모드)
esac
