#!/usr/bin/env bash
# 음성 Agent 운영 포털: portal start | stop | status   (http://127.0.0.1:7100, SSH 터널로 접속)
# GPU 를 쓰지 않는다 (CUDA_VISIBLE_DEVICES=""). gpu-mode 와 무관하게 띄우며, gpu-mode stop 이 이 프로세스를 끄지 않는다.
# 화면에서 할 수 있는 동작은 ada-ops/portal_app/server.py 의 허용 목록뿐이다 (GPU 기동은 gpu-wait 예약으로만).
set -u
OPS="$(cd "$(dirname "$0")" && pwd)"
EN="$(dirname "$OPS")/english-agent"
RUN="$OPS/run"; LOG="$OPS/logs/portal"; PIDF="$RUN/portal.pid"
mkdir -p "$RUN" "$LOG"
PORT=7100

alive() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }

case "${1:-status}" in
start)
  if alive; then echo "이미 실행 중 (pid $(cat "$PIDF"))"; exit 0; fi
  if ss -ltn "sport = :$PORT" | grep -q LISTEN; then echo "port $PORT 사용 중, 중단"; exit 1; fi
  (cd "$OPS" && CUDA_VISIBLE_DEVICES="" exec setsid "$EN/.venv-core/bin/python" portal_app/server.py --port "$PORT") >> "$LOG/portal.log" 2>&1 &
  echo $! > "$PIDF"
  for i in $(seq 1 20); do
    ss -ltn "sport = :$PORT" | grep -q LISTEN && { echo "포털 시작 (pid $(cat "$PIDF")): http://localhost:$PORT"; exit 0; }
    sleep 0.5
  done
  echo "10초 안에 준비되지 않음. $LOG/portal.log 를 확인하세요"; exit 1 ;;
stop)
  alive || { echo "실행 중 아님"; rm -f "$PIDF"; exit 0; }
  kill "$(cat "$PIDF")"; sleep 1; alive && kill -9 "$(cat "$PIDF")"
  rm -f "$PIDF"; echo "포털 중지" ;;
status)
  if alive; then echo "실행 중 (pid $(cat "$PIDF")): http://localhost:$PORT"; else echo "실행 중 아님"; fi ;;
*) echo "사용: portal start|stop|status"; exit 2 ;;
esac
